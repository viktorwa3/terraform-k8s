---
# No identityId: the nodes carry exactly one user-assigned identity.
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: azure-key-vault
spec:
  refreshInterval: 60
  provider:
    azurekv:
      authType: ManagedIdentity
      vaultUrl: {{ argocd_key_vault_uri | regex_replace('/$', '') }}
